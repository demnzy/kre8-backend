# Kre8 Creator Operating System - Environment Configuration

# 1. Google Gemini API Key
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Database Connection
# Default: Local SQLite database
DATABASE_URL=sqlite:///./kre8.db
# Production PostgreSQL (Supabase / Neon / RDS):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# 3. Specialized News API (Optional - defaults to real-time Google News RSS)
# Free key from https://newsapi.org or https://gnews.io
NEWS_API_KEY=

# 4. Security
SECRET_KEY=kre8_super_secret_jwt_key_2026_creator_dashboard
